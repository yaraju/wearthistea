// wearthistea — data model (Phase 1)
// Persistence: PostgreSQL (Neon). Set DATABASE_URL in .env, then run:
//   npx prisma db push
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One "spill" = one keyword run that produced a batch of design options.
model Batch {
  id        String   @id @default(cuid())
  keyword   String
  status    String   @default("generated") // generated | queued | done
  createdAt DateTime @default(now())
  designs   Design[]
}

// A single generated t-shirt concept (text + product shot + clean print file).
// Purely creative/generation content — a purchase of this design is a
// separate Order row (one Design can have many Orders, e.g. two buyers
// picking the same concept), so nothing shipping- or payment-related lives
// here.
model Design {
  id      String @id @default(cuid())
  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Creative content (from the LLM)
  title         String
  phrase        String
  visualConcept String  @db.Text
  vibe          String?
  blurb         String?

  // Pipeline mode this design was generated with ("raster" | "svg"). Source of
  // truth for how to (re)render this design — never infer this from parsing
  // designPrompt text, which is free-form and user-influenced.
  style String @default("raster")

  // The exact prompts used to make the images (handy for re-rolls / debugging)
  designPrompt  String @db.Text
  productPrompt String @db.Text

  // Garment category/color this art was generated/rendered against (drives
  // print geometry + ink-color art direction) — a generation-time choice,
  // fixed before any Order exists, not something a buyer picks at checkout.
  category     String  @default("men")
  variantColor String?

  // Stored artwork (paths under /public, served at the same URL)
  productImagePath String // styled product mockup shown in the grid
  designImagePath  String // clean, print-ready art sent to the provider
  // Base64 copy of the print-ready design — used as fallback when the file is
  // missing (e.g. after a redeploy wipes the ephemeral filesystem on some hosts).
  designImageData  String? @db.Text
  // For SVG-based designs, the original vector source.
  designSVGData    String? @db.Text

  // Lifecycle: generating (concept written, artwork rendering) -> generated ->
  // failed. Order-level lifecycle (approval, payment, fulfillment) lives on
  // Order, not here.
  status String @default("generated")
  // Generation-failure detail (rendering/model errors) — distinct from an
  // Order's errorMessage, which covers approval/fulfillment failures.
  errorMessage String? @db.Text

  // Printrove's uploaded design asset id — set once (on first upload) and
  // reused for every (category, color) DesignProduct below, since the
  // upload itself doesn't depend on category or size. Never re-uploaded
  // once set — see fulfillment.ts / design-products.ts.
  printroveDesignId Int?

  orders         Order[]
  designProducts DesignProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([batchId])
}

// One real Printrove Product Library entry + mockup for a (design, category,
// color) combo, and the unit of admin content-approval. Deliberately NOT
// keyed by size: settings.printrove.products[category].print is a single
// fixed placement box per category, so two sizes of the same design/
// category/color are the identical artwork at the identical coordinates on
// a differently-sized blank — verified live (two Printrove products created
// from the same uploaded design at Men's S and Men's XL produced pixel-
// identical mockups). previewSize records which size the mockup happens to
// have been built from — provenance only, not part of this row's identity.
//
// approvalStatus is content moderation, decoupled from any single Order:
// approve a combo once and every current + future Order for it (any size)
// can auto-fulfill — see fulfillment.ts's pushOrderToProvider and the
// approve/approve-all cascade in the admin API. Approving this row must
// NEVER cause printroveProductId/printroveVariantId (built at previewSize)
// to be reused for an actual order's real size — only printroveDesignId
// (the upload, on Design) is safe to reuse there.
model DesignProduct {
  id       String @id @default(cuid())
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  category String
  color    String // "Black" only for now — see settings.printrove.products

  previewSize        String
  printroveProductId Int?
  printroveVariantId Int?
  mockupFrontUrl     String?
  mockupBackUrl      String?
  // pending | ready | failed — Printrove product-creation/mockup lifecycle.
  status       String  @default("pending")
  errorMessage String? @db.Text

  // unreviewed | approved | rejected
  approvalStatus String    @default("unreviewed")
  reviewedAt     DateTime?
  reviewNote     String?   @db.Text

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([designId, category, color])
  @@index([designId])
}

// One purchase of a Design. Split out from Design so two buyers of the same
// concept never collide on shipping/payment state, and so a failed/retried
// payment or fulfillment attempt has its own row to track.
model Order {
  id       String @id @default(cuid())
  designId String
  design   Design @relation(fields: [designId], references: [id])
  userId   String?
  user     User?  @relation(fields: [userId], references: [id])

  // Which reviewable (design, category, color) combo this order belongs to —
  // set at creation, used to check approvalStatus for the select-time
  // auto-fulfill path and to cascade admin approve/reject to pending orders.
  // Null for pre-migration orders, which fall back to today's exact
  // approve-on-click behavior in /api/admin/approve.
  designProductId String?
  designProduct   DesignProduct? @relation(fields: [designProductId], references: [id])

  // Soft, non-authoritative reference to which saved address was used to
  // prefill this order — the recipient*/address* snapshot fields below
  // remain the source of truth for what actually ships, since a saved
  // Address can be edited/deleted later and an order must not silently
  // change with it.
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  // ── Product & variant ───────────────────────────────────────────────────
  // "men" for now (single hardcoded product) — Phase 2 wires this to a real
  // per-category catalog table (men | women | toddler | kids).
  productCategory String  @default("men")
  variantSize     String?
  variantColor    String?
  quantity        Int     @default(1)

  // ── Pricing (populated at approval time, same timing as today's flat
  // priceCents) ────────────────────────────────────────────────────────────
  unitPriceCents Int?
  gstRateBps     Int?
  gstAmountCents Int?

  // ── Recipient / shipping — nullable to match today's Printify path, which
  // never collects a customer at all ─────────────────────────────────────
  recipientName  String?
  recipientEmail String?
  recipientPhone String?
  addressLine1   String?
  addressLine2   String?
  addressLine3   String?
  city           String?
  state          String?
  pincode        String?
  country        String?

  // ── Payment (Razorpay lands in a later phase; cod is the only live path
  // today) ─────────────────────────────────────────────────────────────────
  paymentProvider   String  @default("cod")
  razorpayOrderId   String?
  razorpayPaymentId String?
  paymentStatus     String  @default("unpaid") // unpaid | paid | failed | refunded
  cod               Boolean @default(true)
  idempotencyKey    String? @unique

  // ── Lifecycle: pending (awaiting admin approval) -> published | rejected
  // | failed. (Payment-aware states like pending_payment/queued_for_admin_review
  // arrive with Razorpay in a later phase.) ──────────────────────────────
  status String @default("pending")

  // ── Fulfillment results (provider-agnostic; named around the current
  // default provider, Printrove) ──────────────────────────────────────────
  printroveProductId String?
  printroveUrl       String?
  printroveOrderId   String?
  trackingNumber     String?
  errorMessage       String? @db.Text

  // ── Invoicing (populated once GST invoicing lands) ─────────────────────
  invoiceNumber String? @unique
  invoiceUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([designId])
  @@index([status])
  @@index([razorpayOrderId])
}

// A signed-in buyer, identified by Firebase UID. authProvider/emailVerified
// come straight off the decoded Firebase ID token at session-mint time
// (google.com | email_link) — see /api/auth/session and src/lib/auth.ts.
model User {
  id             String   @id // Firebase UID
  email          String   @unique
  emailVerified  Boolean  @default(false)
  authProvider   String   @default("email_link")
  marketingOptIn Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders    Order[]
  addresses Address[]
}

// A saved shipping address on a signed-in customer's account. Orders never
// reference these live — checkout copies the chosen Address's fields into
// the new Order's own recipient*/address* snapshot columns, so editing or
// deleting a saved Address can never change what an already-placed order
// ships to (Order.addressId is a soft pointer back to this, for display
// only — see the Order model).
model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String? // e.g. "Home", "Work" — optional nickname
  name      String
  phone     String
  address1  String
  address2  String?
  address3  String?
  city      String?
  state     String?
  pincode   String?
  country   String
  isDefault Boolean @default(false)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Atomically-incrementing named counters (e.g. GST invoice numbers, which
// tax rules require to be strictly sequential with no gaps — a timestamp-
// or id-derived number can't guarantee that under concurrent requests).
model Counter {
  key   String @id
  value Int    @default(0)
}

model Cache {
  key       String   @id
  value     String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
