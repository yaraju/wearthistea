// wearthistea — data model (Phase 1)
// Persistence: PostgreSQL (Neon). Set DATABASE_URL in .env, then run:
//   npx prisma db push
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One "spill" = one keyword run that produced a batch of design options.
model Batch {
  id        String   @id @default(cuid())
  keyword   String
  status    String   @default("generated") // generated | queued | done
  createdAt DateTime @default(now())
  designs   Design[]
}

// A single generated t-shirt concept (text + product shot + clean print file).
// Purely creative/generation content — a purchase of this design is a
// separate Order row (one Design can have many Orders, e.g. two buyers
// picking the same concept), so nothing shipping- or payment-related lives
// here.
model Design {
  id      String @id @default(cuid())
  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Creative content (from the LLM)
  title         String
  phrase        String
  visualConcept String  @db.Text
  vibe          String?
  blurb         String?
  // Cheeky back-of-shirt payoff line, from the same LLM call as `phrase` —
  // see prompts.ts's Concept.backPhrase. Nullable so pre-migration rows
  // don't need a backfill; simply have no back print until regenerated.
  backPhrase String?
  // A/B/C variant for how large/where the back print sits on the garment —
  // randomly assigned at generation time (pickRandomBackLayout in
  // back-design.ts), flippable later by an admin. "upper-back" | "full-panel" | "chest-height".
  backLayout String  @default("upper-back")

  // Pipeline mode this design was generated with ("raster" | "svg"). Source of
  // truth for how to (re)render this design — never infer this from parsing
  // designPrompt text, which is free-form and user-influenced.
  style String @default("raster")

  // The exact prompts used to make the images (handy for re-rolls / debugging)
  designPrompt  String @db.Text
  productPrompt String @db.Text

  // Garment category/color this art was generated/rendered against (drives
  // print geometry + ink-color art direction) — a generation-time choice,
  // fixed before any Order exists, not something a buyer picks at checkout.
  category     String  @default("men")
  variantColor String?

  // Stored artwork (paths under /public, served at the same URL)
  productImagePath String // styled product mockup shown in the grid
  designImagePath  String // clean, print-ready art sent to the provider
  // Downscaled, screen-quality derivatives of the two paths above — every
  // customer-facing view renders these instead, so the full-res print file
  // never reaches the browser. Full-res stays server-side only, read for
  // provider upload / order placement (fulfillment.ts, design-products.ts).
  productPreviewImagePath String?
  designPreviewImagePath  String?
  // Deterministic back-print artwork (cheeky text + QR) and its preview —
  // mirror designImagePath/designPreviewImagePath, see back-design.ts.
  backDesignImagePath        String?
  backDesignPreviewImagePath String?
  // Base64 copy of the print-ready design — used as fallback when the file is
  // missing (e.g. after a redeploy wipes the ephemeral filesystem on some hosts).
  designImageData  String? @db.Text
  // For SVG-based designs, the original vector source.
  designSVGData    String? @db.Text

  // Lifecycle: generating (concept written, artwork rendering) -> generated ->
  // failed. Order-level lifecycle (approval, payment, fulfillment) lives on
  // Order, not here.
  status String @default("generated")
  // Generation-failure detail (rendering/model errors) — distinct from an
  // Order's errorMessage, which covers approval/fulfillment failures.
  errorMessage String? @db.Text

  // ── LLM-as-judge validation lifecycle — separate from `status` above,
  // which stays exactly generating|generated|failed and is read/written in
  // 19 files across the app. This lifecycle is independent:
  // unjudged|pending|validating|regenerating|validated|superseded|rejected.
  // Default is "unjudged" (not "validated") so every pre-existing row is
  // backfilled as "predates this feature" — a bulk judge run can then cheaply
  // find exactly the rows it hasn't looked at yet via
  // `WHERE validationStatus = 'unjudged'`, without needing to distinguish
  // "actually validated" from "never checked". Every new design created going
  // forward is expected to explicitly set "pending" at creation time rather
  // than relying on this default.
  validationStatus String @default("unjudged")
  // Two independent counters (rather than one shared counter) since the two
  // kinds of attempt have different caps and are incremented by different
  // parts of the pipeline: cheap programmatic fixes (cap 2) vs. a full
  // regenerate-from-scratch (cap 1).
  validationFixAttempts   Int     @default(0)
  validationRegenAttempts Int     @default(0)
  // Last judge verdict/issues — for debugging and admin visibility only.
  validationNotes         String? @db.Text

  // Set on the NEW design a bulk-judge (or admin "regenerate") action spawns
  // from a source design — points back at the design it was regenerated
  // from. The source row itself is never mutated; this is the only link
  // between them. Mirrors Order.regeneratedFromOrderId below. @unique
  // enforces at most one regeneration per source design at the DB level
  // (Postgres treats multiple NULLs as distinct in a unique index, so
  // ordinary designs are never constrained by this).
  regeneratedFromDesignId String?  @unique
  regeneratedFrom         Design?  @relation("DesignRegeneration", fields: [regeneratedFromDesignId], references: [id])
  regeneratedInto         Design[] @relation("DesignRegeneration")

  // Printrove's uploaded design asset id — set once (on first upload) and
  // reused for every (category, color) DesignProduct below, since the
  // upload itself doesn't depend on category or size. Never re-uploaded
  // once set — see fulfillment.ts / design-products.ts. String, not Int:
  // Printrove's design-asset ids are 11 digits, overflowing Postgres INT4 —
  // same reason Order.printroveProductId below is already a String.
  printroveDesignId String?
  // Mirrors printroveDesignId for the back-print asset — reused across every
  // (category, color) combo, reset to null whenever the back art changes
  // (color re-render, admin layout flip) so the next PrintRove touch
  // re-uploads instead of reusing stale art.
  printroveBackDesignId String?

  // Shareable identity: slugify(title) + "-" + id, set once the design row
  // has an id (see /api/generate and scripts/backfill-designs.ts). Nullable
  // only for pre-migration rows awaiting backfill — every design created
  // going forward gets one immediately. @unique is safe with no collision
  // handling because the id suffix already guarantees uniqueness.
  slug String? @unique

  // Who brewed this design (for a future "your brews" account page).
  // createdByAnonId is set on every brew from the anon-id header the client
  // already sends (see ANON_ID_HEADER); createdByUserId is set immediately
  // when the brewer already has a session, and backfilled onto matching
  // createdByAnonId rows when that anon browser later signs in (see
  // /api/auth/session). Neither is required to brew.
  createdByUserId String?
  createdByUser   User?   @relation("DesignsBrewed", fields: [createdByUserId], references: [id])
  createdByAnonId String?

  // Semantic-search embeddings (Gemini text-embedding-004, 768-dim, cosine
  // similarity via pgvector's <=> operator) over the three text axes the
  // catalog/pre-brewed matching search on: the raw brew keyword (denormalized
  // down from Batch.keyword so a search never needs to join Batch), the
  // concept (title + phrase + visualConcept), and the back phrase (nullable,
  // same as backPhrase itself). Unsupported() because Prisma has no native
  // vector type — this EXCLUDES these three columns from the generated
  // Prisma Client entirely, so every existing prisma.design.* call keeps
  // compiling unchanged. All reads/writes of these columns go through
  // $queryRaw/$executeRaw only — see src/lib/embeddings.ts and
  // src/lib/design-search.ts. The pgvector extension and the HNSW indexes on
  // these columns are created out-of-band by scripts/setup-pgvector-*.ts,
  // never by `prisma db push`.
  keywordEmbedding    Unsupported("vector(768)")?
  conceptEmbedding    Unsupported("vector(768)")?
  backPhraseEmbedding Unsupported("vector(768)")?

  orders         Order[]
  designProducts DesignProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([batchId])
  @@index([createdByUserId])
  @@index([createdByAnonId])
  @@index([validationStatus])
}

// One real Printrove Product Library entry + mockup for a (design, category,
// color) combo, and the unit of admin content-approval. Deliberately NOT
// keyed by size: settings.printrove.products[category].print is a single
// fixed placement box per category, so two sizes of the same design/
// category/color are the identical artwork at the identical coordinates on
// a differently-sized blank — verified live (two Printrove products created
// from the same uploaded design at Men's S and Men's XL produced pixel-
// identical mockups). previewSize records which size the mockup happens to
// have been built from — provenance only, not part of this row's identity.
//
// approvalStatus is content moderation, decoupled from any single Order:
// approve a combo once and every current + future Order for it (any size)
// can auto-fulfill — see fulfillment.ts's pushOrderToProvider and the
// approve/approve-all cascade in the admin API. Approving this row must
// NEVER cause printroveProductId/printroveVariantId (built at previewSize)
// to be reused for an actual order's real size — only printroveDesignId
// (the upload, on Design) is safe to reuse there.
model DesignProduct {
  id       String @id @default(cuid())
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  category String
  color    String // "Black" only for now — see settings.printrove.products

  previewSize String
  // String, not Int — same overflow reason as Design.printroveDesignId
  // above; kept consistent even though product/variant ids observed so far
  // happen to fit in Int32, since Printrove's id space isn't documented.
  printroveProductId String?
  printroveVariantId String?
  mockupFrontUrl     String?
  mockupBackUrl      String?
  // pending | ready | failed — Printrove product-creation/mockup lifecycle.
  status       String  @default("pending")
  errorMessage String? @db.Text

  // unreviewed | approved | rejected
  approvalStatus String    @default("unreviewed")
  reviewedAt     DateTime?
  reviewNote     String?   @db.Text

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([designId, category, color])
  @@index([designId])
}

// One purchase of a Design. Split out from Design so two buyers of the same
// concept never collide on shipping/payment state, and so a failed/retried
// payment or fulfillment attempt has its own row to track.
model Order {
  id       String @id @default(cuid())
  designId String
  design   Design @relation(fields: [designId], references: [id])
  userId   String?
  user     User?  @relation(fields: [userId], references: [id])

  // Which reviewable (design, category, color) combo this order belongs to —
  // set at creation, used to check approvalStatus for the select-time
  // auto-fulfill path and to cascade admin approve/reject to pending orders.
  // Null for pre-migration orders, which fall back to today's exact
  // approve-on-click behavior in /api/admin/approve.
  designProductId String?
  designProduct   DesignProduct? @relation(fields: [designProductId], references: [id])

  // Soft, non-authoritative reference to which saved address was used to
  // prefill this order — the recipient*/address* snapshot fields below
  // remain the source of truth for what actually ships, since a saved
  // Address can be edited/deleted later and an order must not silently
  // change with it.
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  // ── Product & variant ───────────────────────────────────────────────────
  // "men" for now (single hardcoded product) — Phase 2 wires this to a real
  // per-category catalog table (men | women | toddler | kids).
  productCategory String  @default("men")
  variantSize     String?
  variantColor    String?
  quantity        Int     @default(1)

  // ── Pricing (populated at approval time, same timing as today's flat
  // priceCents) ────────────────────────────────────────────────────────────
  unitPriceCents Int?
  gstRateBps     Int?
  gstAmountCents Int?

  // ── Recipient / shipping — nullable to match today's Printify path, which
  // never collects a customer at all ─────────────────────────────────────
  recipientName  String?
  recipientEmail String?
  recipientPhone String?
  addressLine1   String?
  addressLine2   String?
  addressLine3   String?
  city           String?
  state          String?
  pincode        String?
  country        String?

  // ── Payment (Razorpay lands in a later phase; cod is the only live path
  // today) ─────────────────────────────────────────────────────────────────
  paymentProvider   String  @default("cod")
  razorpayOrderId   String?
  razorpayPaymentId String?
  paymentStatus     String  @default("unpaid") // unpaid | paid | failed | refunded
  cod               Boolean @default(true)
  idempotencyKey    String? @unique

  // ── Lifecycle: pending (awaiting admin approval) -> published | rejected
  // | failed. (Payment-aware states like pending_payment/queued_for_admin_review
  // arrive with Razorpay in a later phase.) ──────────────────────────────
  status String @default("pending")

  // ── Fulfillment results (provider-agnostic; named around the current
  // default provider, Printrove) ──────────────────────────────────────────
  printroveProductId String?
  printroveUrl       String?
  printroveOrderId   String?
  trackingNumber     String?
  errorMessage       String? @db.Text

  // ── Invoicing (populated once GST invoicing lands) ─────────────────────
  invoiceNumber String? @unique
  invoiceUrl    String?

  // Durable, write-once — set the first time the live-status read-through
  // cache (see OrderStatusCache/order-status.ts) resolves this order as
  // delivered. Never overwritten after that. This, not the live cache, is
  // what "delivered this week" bucketing on /account/orders reads, since
  // Printrove's live response gives current state, not a delivery date.
  deliveredAt DateTime?

  // Set on the NEW order a customer's "regenerate" click spawns from a
  // rejected order — points back at the rejected order it replaced. The
  // rejected row itself is never mutated; this is the only link between
  // them. @unique enforces at most one regeneration per rejected order at
  // the DB level (Postgres treats multiple NULLs as distinct in a unique
  // index, so ordinary orders are never constrained by this).
  regeneratedFromOrderId String? @unique
  regeneratedFrom        Order?  @relation("OrderRegeneration", fields: [regeneratedFromOrderId], references: [id])
  regeneratedInto        Order[] @relation("OrderRegeneration")

  statusCache OrderStatusCache?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([designId])
  @@index([status])
  @@index([razorpayOrderId])
  @@index([userId])
}

// Read-through cache of Printrove's live order status, refreshed on-demand
// when a customer opens /account/orders (see printrove-order-status.ts) —
// there is no webhook. Deliberately kept off Order itself: writing these
// fields directly onto Order would bump Order.updatedAt on every single
// customer page view, and /api/admin/batches sorts the admin queue by
// `orderBy: { updatedAt: "desc" }` — that churn would float a customer's
// in-flight order to the top of the admin queue every time they refresh
// their own order page.
model OrderStatusCache {
  orderId String @id
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Exactly as Printrove returned it — kept for debugging/remapping, since
  // the real field name/values are unconfirmed until tested live (see
  // scripts/test-order-status.ts).
  statusRaw String? @db.Text
  // One of: printing | dispatched | out_for_delivery | delivered — see
  // mapPrintroveStatus in printrove-status.ts. Null until first fetched.
  statusSimplified String?
  trackingUrl       String?
  courierName       String?

  fetchedAt DateTime @default(now())
}

// A signed-in buyer, identified by Firebase UID. authProvider/emailVerified
// come straight off the decoded Firebase ID token at session-mint time
// (google.com | email_link) — see /api/auth/session and src/lib/auth.ts.
model User {
  id             String   @id // Firebase UID
  email          String   @unique
  emailVerified  Boolean  @default(false)
  authProvider   String   @default("email_link")
  marketingOptIn Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders        Order[]
  addresses     Address[]
  brewedDesigns Design[] @relation("DesignsBrewed")
}

// A saved shipping address on a signed-in customer's account. Orders never
// reference these live — checkout copies the chosen Address's fields into
// the new Order's own recipient*/address* snapshot columns, so editing or
// deleting a saved Address can never change what an already-placed order
// ships to (Order.addressId is a soft pointer back to this, for display
// only — see the Order model).
model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String? // e.g. "Home", "Work" — optional nickname
  name      String
  phone     String
  address1  String
  address2  String?
  address3  String?
  city      String?
  state     String?
  pincode   String?
  country   String
  isDefault Boolean @default(false)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Atomically-incrementing named counters (e.g. GST invoice numbers, which
// tax rules require to be strictly sequential with no gaps — a timestamp-
// or id-derived number can't guarantee that under concurrent requests).
model Counter {
  key   String @id
  value Int    @default(0)
}

model Cache {
  key       String   @id
  value     String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Live-editable image-generation rate limits (replaces the old RATE_LIMIT_*
// env vars) — one shared window, three tier ceilings. Singleton row, id
// fixed to "singleton". Edited from /admin/rate-limits; read (with a short
// in-memory cache) by src/lib/rate-limit.ts on every generate/retry/realize
// call, so a missing row must fall back to hardcoded defaults there rather
// than erroring.
model RateLimitConfig {
  id             String   @id @default("singleton")
  windowMs       Int      @default(3600000)
  maxAnonymous   Int      @default(10)
  maxSignedIn    Int      @default(25)
  maxAdmin       Int      @default(1000)
  updatedAt      DateTime @updatedAt
  updatedByEmail String?
}

// Per-email override of the signed-in tier ceiling — takes precedence over
// RateLimitConfig.maxSignedIn for this exact email, using the same shared
// RateLimitConfig.windowMs (not independently configurable). Never applies
// to a request authenticated as admin — see checkGenerateRateLimit.
model RateLimitOverride {
  id             String   @id @default(cuid())
  email          String   @unique
  maxPerWindow   Int
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedByEmail String?
}

// Bulk judge-run tracking (issue #19) — a lightweight record of one
// admin-triggered bulk sweep over the same judgeOneDesign() core
// scripts/judge-designs.ts (issue #18) uses, so the admin UI can poll live
// progress instead of shelling in to watch a CLI. Checked first for an
// existing job-tracking pattern to reuse (per issue #19's own instruction):
// Counter is a single-int KV, Cache is a generic TTL string KV — neither
// fits a run's shape (counts + JSON breakdowns + a frozen mode), so this is
// new, additive-only, no changes to any existing table.
model JudgeRun {
  id String @id @default(cuid())

  // "auto" (apply=true — a passing design validates in place, a failing
  // eligible one auto-regenerates a sibling, an excluded one is flagged) |
  // "manual" (apply=false — nothing is written automatically; every judge
  // failure is surfaced for an explicit per-design "regenerate" click).
  // Frozen for the life of the run: src/lib/judge-run.ts's
  // advanceJudgeRun() always derives `apply` from THIS persisted column,
  // never from a step's task payload, and no route ever updates it once the
  // row exists (PATCH /api/admin/judge-runs/[id] always 409s).
  mode         String
  statusFilter String
  limit        Int

  // "running" | "completed" | "failed" — never returns to "running" once
  // it leaves that state.
  status String @default("running")

  // JSON string[] — the exact Design ids in scope, snapshotted once at
  // creation (same orderBy as scripts/judge-designs.ts: createdAt asc, id
  // asc) so a per-step re-query never sees a shifting window as designs'
  // validationStatus changes mid-run (auto mode moves designs OUT of the
  // very filter that selected them).
  designIds String @db.Text
  total     Int
  processed Int    @default(0)

  // JSON Record<JudgeOneOutcome, number>, accumulated incrementally.
  outcomeCounts String @db.Text @default("{}")
  // JSON BulkDesignVerdict[] (design-judge-bulk.ts) accumulated
  // incrementally — buildRubricReport()/formatRubricSummary() (issue #17)
  // are recomputed from this on read, so the five named rubrics' pass rates
  // can never drift from the CLI script's own reporting logic.
  verdicts String @db.Text @default("[]")
  // JSON FlaggedDesignEntry[] (src/lib/judge-run.ts) — designs whose
  // outcome needs admin attention: excluded-and-flagged (either mode) or,
  // in manual mode only, every judge failure (since nothing auto-fixes).
  flagged String @db.Text @default("[]")

  error       String?   @db.Text
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdByEmail String?
}
