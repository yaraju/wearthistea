# ─────────────────────────────────────────────────────────────────────────────
#  wearthistea — environment
#  Copy this file to `.env` and fill in your own values.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (Neon). Use the POOLED connection string for the app.
#   Neon → Dashboard → Connection Details → "Pooled connection"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Google Gemini (AI Studio key — NOT the consumer app subscription)
#   Get one free: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional model overrides (sensible defaults live in src/config/settings.ts)
# GEMINI_TEXT_MODEL="gemini-2.5-flash"
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# ── Fulfillment provider ─────────────────────────────────────────────────────
# Which print/fulfillment backend to use: "printrove" (default) or "printify".
PRINT_PROVIDER="printrove"

# ── Razorpay (prepaid checkout) ──────────────────────────────────────────────
#   Dashboard → Settings → API Keys. Use the TEST mode keys until you're
#   ready to go live with real payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
#   Dashboard → Settings → Webhooks → add https://<your-domain>/api/webhooks/razorpay,
#   subscribed to "payment.captured" — the secret you set there, not your API key secret.
RAZORPAY_WEBHOOK_SECRET=""

# ── Transactional email (SendGrid via Nodemailer's SMTP relay) ──────────────
SENDGRID_API_KEY=""
EMAIL_FROM="wearthistea <no-reply@yourdomain.com>"

# ── Cloud Tasks (async email + Printrove product-library creation) ──────────
#   All optional — if either queue name is unset, that workload runs inline
#   instead of via the queue (fine for local dev; not for production, where
#   a slow SendGrid/Printrove call would otherwise hold open a payment
#   webhook or the design-generation response).
#   Queues are provisioned automatically by the deploy workflow
#   (.github/workflows/deploy.yml, "Ensure Cloud Tasks queues" step) — you
#   don't need to run `gcloud tasks queues create` by hand for a deploy, only
#   for local testing against a real queue.
#   Kept as two separate queues (not one) so retry/concurrency can be tuned
#   per workload — see that workflow step for the actual values.
# CLOUD_TASKS_QUEUE_EMAIL="email"
# CLOUD_TASKS_QUEUE_PRINTROVE="printrove-products"
# GCP_PROJECT_ID="wearthistea"
# GCP_REGION="us-central1"
#   Publicly reachable base URL Cloud Tasks calls back into.
# SITE_URL="https://wearthistea.web.app"
#   Shared secret Cloud Tasks sends back in X-Task-Secret — generate any
#   random string (e.g. `openssl rand -hex 32`); this is NOT your Razorpay
#   or Printrove secret. Shared across both queues' task handlers.
# TASKS_SHARED_SECRET=""

# ── Seller of record (for GST invoices sent to customers) ───────────────────
#   Printrove is NOT the seller of record to your customer — you are. These
#   MUST be your real registration details before any invoice goes out for
#   real; the code falls back to obvious placeholder strings if unset.
SELLER_BUSINESS_NAME=""
SELLER_GSTIN=""
SELLER_ADDRESS=""
SELLER_STATE="Karnataka"          # matched against the buyer's state to pick CGST+SGST vs IGST

# Printrove (used when PRINT_PROVIDER=printrove)
#   Auth: your Printrove merchant login → POST https://api.printrove.com/api/external/token
PRINTROVE_EMAIL=""
PRINTROVE_PASSWORD=""
#   The 4 supported garment categories (men/women/toddler/kids — half sleeve,
#   black only) are hardcoded in src/config/settings.ts's `printrove.products`
#   table, not driven by env vars — each entry's subtypeId/variantMap/print
#   geometry was pulled from Printrove's live catalog API and, for Toddler,
#   verified against a real rendered mockup. Add a category by adding a row
#   there, not by editing env vars.
# PRINTROVE_COUNTRIES="India,United States,United Kingdom,Canada,Australia"
# PRINTROVE_COD="true"                      # default orders to cash-on-delivery
# PRINTROVE_RETAIL_PRICE_MEN="599"          # per-category retail price (defaults in settings.ts)
# PRINTROVE_RETAIL_PRICE_WOMEN="599"
# PRINTROVE_RETAIL_PRICE_TODDLER="599"
# PRINTROVE_RETAIL_PRICE_KIDS="599"

# Printify (used when PRINT_PROVIDER=printify)
#   Token: Printify → Settings → Connections → "Generate" a Personal Access Token
#   Shop ID: GET https://api.printify.com/v1/shops.json (with the token)
PRINTIFY_API_TOKEN=""
PRINTIFY_SHOP_ID=""

# ── Optional tuning (defaults in src/config/settings.ts) ─────────────────────
# OPTIONS_PER_KEYWORD="5"
# PRINTIFY_PRICE_CENTS="2999"     # retail price per shirt in cents = your markup lever
# PRINTIFY_DEFAULT_COLOR="Black"
# PRINTIFY_SIZES="S,M,L,XL,2XL"
# PRINTIFY_PUBLISH="true"          # set false to create products without publishing live

# ── Hosting (Railway) ────────────────────────────────────────────────────────
# Where generated artwork is written. Defaults to ./public/generated locally
# (fine for dev — no redeploys to lose it to). In production (Cloud Run),
# set GCS_BUCKET instead — the container filesystem is ephemeral, so without
# it every redeploy silently loses all previously-generated artwork.
# GCS_BUCKET="wearthistea-designs-<PROJECT_ID>"
#   STORAGE_DIR is a local-disk alternative to GCS_BUCKET (e.g. a mounted
#   volume path) — set at most one of the two; GCS_BUCKET takes priority if
#   both are set. Also gates Design.designImageData: that base64 fallback
#   column only gets written when GCS_BUCKET is unset, since GCS already
#   persists the real file durably (see hasDurableStorage in lib/storage.ts).
# STORAGE_DIR="/data"

# Shared-secret gate (HTTP Basic Auth). When BOTH are set, the whole site is
# protected behind a browser password prompt. Leave unset for open local dev.
#   Turned OFF in production as of this deploy — Razorpay's onboarding needs
#   to reach the site without a password prompt. The free-generation budget
#   is now protected by src/lib/rate-limit.ts (cookie+IP) instead of this;
#   /admin and /api/admin/* are protected by the Firebase Google-sign-in gate
#   below regardless of this setting.
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""

# ── Firebase Auth (admin sign-in via Google only; magic-link checkout is a
#    later feature) ────────────────────────────────────────────────────────
#   Accounts allowed into /admin — must sign in with Google specifically
#   (email/password and email-link are also enabled on this Firebase project,
#   but not accepted for admin — see src/lib/auth.ts).
ADMIN_EMAILS="yaraju@gmail.com,wearthistea@gmail.com"
#   Server-side (firebase-admin): no keys needed here. It uses Application
#   Default Credentials — Cloud Run's attached service account in
#   production, or `gcloud auth application-default login` locally.
#   Client-side (firebase/auth), from Firebase Console → Project Settings →
#   your web app's config. These are public by design (restrict the API key
#   to your domain in the GCP Console, not by hiding it). NOTE: these
#   NEXT_PUBLIC_ vars are baked in at BUILD time, not read at runtime — see
#   the build-arg wiring in Dockerfile / .github/workflows/deploy.yml.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="wearthistea.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="wearthistea"
NEXT_PUBLIC_FIREBASE_APP_ID=""
#   Firebase Console → Authentication → Sign-in method → Google must be
#   enabled. Add your deployed domain (and localhost) under Authentication →
#   Settings → Authorized domains, or the Google popup will fail.

# ── Free-generation rate limiting (no login required — see src/lib/rate-limit.ts) ─
# RATE_LIMIT_WINDOW_MS="3600000"     # 1 hour
# RATE_LIMIT_MAX_PER_SESSION="10"
# RATE_LIMIT_MAX_PER_IP="25"

# ── Observability (Langfuse) ──────────────────────────────────────────────────
#   Get your keys: https://cloud.langfuse.com/
NEXT_PUBLIC_LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
# LANGFUSE_BASEURL="https://cloud.langfuse.com"

# ── Analytics (Google Analytics 4) ───────────────────────────────────────────
#   Create a GA4 property + web data stream directly at analytics.google.com
#   (not via the Firebase console — this app doesn't use the firebase/analytics
#   SDK) and copy the Measurement ID from there.
#   NOTE: like the Firebase vars above, this is baked in at BUILD time, not
#   read at runtime — see the build-arg wiring in Dockerfile /
#   .github/workflows/deploy.yml. Leave unset locally to disable GA entirely.
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXX"
